<Window x:Class="MVVM1.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roles" Height="300" Width="300">
    <StackPanel Background="#FFD8D8D8">
        <Label Margin="5" HorizontalAlignment="Center">List of Employee Roles</Label>
        <ListView x:Name="lvRole" Background="#FFD3CDCD">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="ID"   Width="50" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Role Name"        DisplayMemberBinding="{Binding NameRole}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>